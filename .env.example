# Copy to .env.local and fill in. No value here is a real secret.

# --- database -------------------------------------------------------------
# The application connects as the restricted runtime role, never as an owner.
DEEDBOX_DATABASE_URL=postgresql://user:password@host:5432/postgres
DEEDBOX_DATABASE_SSL=require
DEEDBOX_POOL_MAX=10

# --- application ----------------------------------------------------------
DEEDBOX_APP_ORIGIN=http://localhost:3000
# Signing key for session cookies. Generate your own; never reuse this.
DEEDBOX_COOKIE_SECRET=
# Signing key for the "open in Word" WebDAV tokens.
DEEDBOX_DAV_SECRET=
# Shared secret the scheduled jobs present when they call in.
DEEDBOX_JOB_SECRET=
# Set only in development: allows sign-in without the full challenge.
DEEDBOX_DEV_SIGNIN=

# --- object storage for document bytes ------------------------------------
DEEDBOX_PLATFORM_URL=
DEEDBOX_PLATFORM_ANON_KEY=
DEEDBOX_PLATFORM_SERVICE_KEY=
DEEDBOX_DOCUMENT_BUCKET=documents

# --- outbound e-mail ------------------------------------------------------
DEEDBOX_MAIL_FROM=
RESEND_API_KEY=

# --- document conversion (optional) ---------------------------------------
# A Gotenberg instance, used to render finished documents as PDF. Without it
# the send ceremony refuses rather than sending a message without its
# document.
DEEDBOX_GOTENBERG_URL=
DEEDBOX_GOTENBERG_USER=
DEEDBOX_GOTENBERG_PASS=

# --- assistant (optional) -------------------------------------------------
DEEDBOX_ASSISTANT_API_KEY=
DEEDBOX_ASSISTANT_MODEL=

# --- validation tools only ------------------------------------------------
# Used by tools/validate-chain.py and tools/validate-app.py, which provision
# and destroy a throwaway database. Either export SUPABASE_MANAGEMENT_PAT, or
# point this at a file that defines it.
DEEDBOX_SECRETS_FILE=
